# RunwaySurfer proxy backend — configurazione
#
# Copia questo file in `server/.env` per lo sviluppo locale: il backend lo legge
# all'avvio (vedi src/load-env.ts). Le variabili già presenti nell'ambiente
# vincono sul file, quindi un `VAR=x npm run dev` continua a funzionare.
#
# In produzione questo file NON viene usato: la unit systemd legge
# /etc/runwaysurfer/runwaysurfer.env (vedi deploy/runwaysurfer.service), che sta
# fuori dalla cartella di deploy proprio per non essere sovrascritto da un
# aggiornamento.

# Provider AI: 'mock' (default, demo, nessuna chiamata reale) | 'anthropic'
AI_PROVIDER=mock

# Necessaria solo con AI_PROVIDER=anthropic. Custodita sul server, mai nell'estensione.
ANTHROPIC_API_KEY=

# --- Rete e TLS (HTTPS terminato da Node, senza reverse proxy) ---

# Porta di ascolto. Con il TLS attivo il default è 443, così l'indirizzo che gli
# agenti hanno in configurazione non si porta dietro una porta; senza TLS il
# default è 8787. Su Linux, per legare una porta < 1024 come utente non
# privilegiato serve AmbientCapabilities=CAP_NET_BIND_SERVICE nella unit systemd
# (vedi deploy/runwaysurfer.service).
PORT=

# Interfaccia di ascolto. Vuoto = tutte. In produzione NON mettere 127.0.0.1:
# l'estensione gira sui PC degli agenti, non su questa macchina.
HOST=

# Certificato e chiave in formato PEM. Se ci sono ENTRAMBI il servizio parte in
# HTTPS; se sono vuoti parte in HTTP in chiaro (sviluppo e demo Docker). Se ne
# imposti solo una il servizio NON parte: mezza configurazione TLS è un errore di
# deploy, non un default.
# I file li scrive il client ACME tramite deploy/tls-deploy-hook.sh: il rinnovo
# NON è compito dell'applicativo, che si limita a rileggerli quando cambiano.
#
# LASCIATE VUOTE di proposito: questo file è un modello, e chi lo copia in
# `server/.env` per lavorare in locale non ha quei percorsi. In produzione
# decommentare le due righe qui sotto.
#   TLS_CERT_PATH=/etc/runwaysurfer/tls/fullchain.pem
#   TLS_KEY_PATH=/etc/runwaysurfer/tls/privkey.pem
#
# Per provare il percorso TLS in locale si possono usare le fixture dei test:
#   TLS_CERT_PATH=tests/fixtures/tls/test-only.crt
#   TLS_KEY_PATH=tests/fixtures/tls/test-only.key
#   PORT=8443
TLS_CERT_PATH=
TLS_KEY_PATH=

# Catena intermedia separata: serve solo se TLS_CERT_PATH non è già un fullchain.
TLS_CA_PATH=

# Passphrase della chiave, se cifrata. Meglio una chiave senza passphrase:
# altrimenti anche il rinnovo automatico deve conoscerla, in un secondo posto.
TLS_KEY_PASSPHRASE=

# Ogni quanto rileggere i file per accorgersi di un rinnovo (ms, default 6h). Il
# certificato viene rinnovato con 30 giorni di margine, quindi qualche ora di
# ritardo è irrilevante; le connessioni già aperte restano sul certificato
# precedente e non vengono interrotte, quindi dopo un rinnovo NON serve
# riavviare. `systemctl reload runwaysurfer` forza la ricarica immediata.
TLS_RELOAD_POLL_MS=

# Giorni di preavviso sulla scadenza: sotto questa soglia ogni controllo scrive
# un avviso [tls] nei log (default 21). È il modo per accorgersi che il rinnovo
# automatico si è fermato PRIMA che il certificato scada: il giorno della
# scadenza il servizio si ferma per tutti gli agenti insieme, e dentro la KB
# nessuno può accettare un'eccezione sul certificato.
TLS_EXPIRY_WARN_DAYS=

# Porta HTTP che risponde SOLO con un 301 verso https. Vuoto = disattivata; in
# produzione impostare 80. Serve alle persone che aprono /dashboard da un vecchio
# segnalibro http://; l'estensione non la usa mai, e NON serve al rinnovo del
# certificato (la validazione è DNS-01, che non tocca la porta 80).
HTTP_REDIRECT_PORT=

# Intervallo del keep-alive SSE su /ask (ms, default 15000). La sidebar
# interrompe lo stream dopo 30s di silenzio: questo commento periodico tiene vivo
# il contatore mentre il modello sta ancora ragionando. Non alzarlo sopra i 15s
# senza aggiornare STREAM_IDLE_TIMEOUT_MS in lib/client.ts.
ASK_PING_MS=

# Origin consentite per il CORS, separate da virgola. Per la demo mock va bene
# '*'; con AI_PROVIDER=anthropic è OBBLIGATORIA (il server non si avvia con '*').
#
# In produzione servono DUE valori, e sono sempre questi su tutte le macchine:
#
#   ALLOWED_ORIGIN=https://traveler.my.site.com,chrome-extension://ihpknodkjnjcbdfmdneeeollnedbdcpd
#
# Il PRIMO è l'origin della Knowledge Base, ed è quello che conta: la sidebar è
# un content script iniettato nella pagina KB, e in Manifest V3 le sue chiamate
# viaggiano con l'Origin della PAGINA, non dell'estensione (Chrome ha rimosso il
# bypass CORS per i content script nella versione 85). Senza di esso il browser
# blocca OGNI richiesta degli agenti, e il messaggio che leggono — «Backend non
# raggiungibile» — sembra un problema di rete. Il server rifiuta di partire col
# provider reale se manca: è un errore troppo costoso da scoprire in esercizio.
#
# Il SECONDO è l'origin dell'estensione, da cui gira la pagina delle opzioni con
# il suo pulsante «Test connessione». Se si ammette solo il primo, il servizio
# funziona ma l'installatore perde l'unica autodiagnosi che ha.
#
# L'extension ID è FISSO (chiave pubblica nel manifest), quindi non cambia da
# macchina a macchina.
ALLOWED_ORIGIN=*

# --- Autenticazione ---

# Bootstrap del primo amministratore: al primo avvio, se nessun admin ha una
# password, viene creato l'utente ADMIN_USERNAME con questa password
# temporanea (cambio obbligatorio al primo login). Ignorata se un admin con
# password esiste già.
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Flag Secure sul cookie di sessione della dashboard. Se lasciata vuota viene
# DERIVATA dal TLS: attiva quando TLS_CERT_PATH e TLS_KEY_PATH sono impostate,
# spenta in HTTP (su http://localhost il browser scarterebbe il cookie). Va
# impostata a mano solo per forzarla: COOKIE_SECURE=0 la disattiva anche in HTTPS.
COOKIE_SECURE=

# --- Guardrail (valori iniziali; poi modificabili dalla dashboard) ---

# Budget del MESE in corso, in euro. Applicato leggendo la somma reale dalla
# tabella `requests`, quindi sopravvive ai riavvii del servizio.
# Riferimento: una domanda costa ~$0,02-0,09 (~€0,02-0,09), quindi €70 ≈ 800-3500
# domande al mese secondo il modello che il router sceglie.
MAX_MONTHLY_ESTIMATED_COST_EUR=70

# Dollari per euro, usato SOLO per confrontare la spesa (il listino dei modelli è
# in USD) con il budget in euro. Tasso fisso, non un cambio in tempo reale: va
# bene per un tetto di spesa, non per la contabilità. Va rivisto se il cambio si
# muove sensibilmente.
USD_PER_EUR=1.05

# Richieste a pagamento per agente per ora. La concorrenza limita quante partono
# INSIEME; questo limita quante in sequenza, e ferma un ciclo impazzito.
MAX_REQUESTS_PER_HOUR_PER_AGENT=30

# Percorso del database SQLite. Default: server/data/runwaysurfer.db
# Il backup deve prendere .db, .db-wal e .db-shm insieme (vedi RUNBOOK-BACKEND.md).
RUNWAYSURFER_DB_PATH=
