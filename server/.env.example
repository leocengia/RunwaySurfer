# RunwaySurfer proxy backend — configuration

# Provider AI: 'mock' (default, demo, nessuna chiamata reale) | 'anthropic'
AI_PROVIDER=mock

# Necessaria solo con AI_PROVIDER=anthropic. Custodita sul server, mai nell'estensione.
ANTHROPIC_API_KEY=

# Porta HTTP del proxy (esporre via reverse proxy con TLS).
PORT=8787

# Origine consentita per il CORS. Per la demo mock va bene '*'; con
# AI_PROVIDER=anthropic è OBBLIGATORIA (il server non si avvia con '*').
# L'extension ID è FISSO (chiave pubblica nel manifest), quindi in produzione il
# valore è sempre questo, su tutte le macchine:
#   ALLOWED_ORIGIN=chrome-extension://ihpknodkjnjcbdfmdneeeollnedbdcpd
ALLOWED_ORIGIN=*

# --- Autenticazione ---

# Bootstrap del primo amministratore: al primo avvio, se nessun admin ha una
# password, viene creato l'utente ADMIN_USERNAME con questa password
# temporanea (cambio obbligatorio al primo login). Ignorata se un admin con
# password esiste già.
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Imposta a 1 quando il backend è servito via HTTPS (reverse proxy TLS):
# aggiunge il flag Secure al cookie di sessione della dashboard.
# Lasciare vuoto in sviluppo su http://localhost.
COOKIE_SECURE=

# --- Guardrail (valori iniziali; poi modificabili dalla dashboard) ---

# Tetto di spesa stimata per giornata (UTC). Applicato leggendo la somma reale
# dalla tabella `requests`, quindi sopravvive ai riavvii del servizio.
# Riferimento: una domanda costa ~$0,02-0,09, quindi 50 ≈ 600-1000 domande.
MAX_DAILY_ESTIMATED_COST_USD=50

# Richieste a pagamento per agente per ora. La concorrenza limita quante partono
# INSIEME; questo limita quante in sequenza, e ferma un ciclo impazzito.
MAX_REQUESTS_PER_HOUR_PER_AGENT=30

# Percorso del database SQLite. Default: server/data/runwaysurfer.db
# Il backup deve prendere .db, .db-wal e .db-shm insieme (vedi RUNBOOK-BACKEND.md).
RUNWAYSURFER_DB_PATH=
