# RunwaySurfer proxy backend — configuration

# Provider AI: 'mock' (default, demo, nessuna chiamata reale) | 'anthropic'
AI_PROVIDER=mock

# Necessaria solo con AI_PROVIDER=anthropic. Custodita sul server, mai nell'estensione.
ANTHROPIC_API_KEY=

# Porta HTTP del proxy (esporre via reverse proxy con TLS).
PORT=8787

# Origine consentita per il CORS. In produzione: l'origin dell'estensione
# (chrome-extension://<id>). Per la demo va bene '*'.
ALLOWED_ORIGIN=*

# --- Autenticazione ---

# Bootstrap del primo amministratore: al primo avvio, se nessun admin ha una
# password, viene creato l'utente ADMIN_USERNAME con questa password
# temporanea (cambio obbligatorio al primo login). Ignorata se un admin con
# password esiste già.
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Imposta a 1 quando il backend è servito via HTTPS (reverse proxy TLS):
# aggiunge il flag Secure al cookie di sessione della dashboard.
# Lasciare vuoto in sviluppo su http://localhost.
COOKIE_SECURE=
