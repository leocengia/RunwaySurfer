{
  "name": "runwaysurfer",
  "description": "AI Runway Sidebar — browser extension that helps call-center agents navigate a knowledge base and get an operational outcome.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
